# ============================================
# Dr.Saju Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- AI (OpenAI) ---
OPENAI_API_KEY=your_openai_api_key

# --- Toss Payments ---
# NEXT_PUBLIC_TOSS_CLIENT_KEY is used by the client-side widget
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_your_toss_client_key
# TOSS_SECRET_KEY is server-only — never expose to client
TOSS_SECRET_KEY=test_sk_your_toss_secret_key
# TOSS_WEBHOOK_SECRET_KEY is the shared secret configured in Toss Payments Dashboard
TOSS_WEBHOOK_SECRET_KEY=your_toss_webhook_secret_key

# --- Email (Resend) ---
RESEND_API_KEY=your_resend_api_key

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAILS=your_admin_email@example.com

# --- Telegram Admin Notifications ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_PAYMENTS_CHAT_ID=your_telegram_chat_id

# --- 외부 결제 (trainer-milestone.com) ---
# 주문조회 API 베이스. 키 인증 없음. 반드시 서버(라우트 핸들러)에서만 호출한다.
# 미설정 시 결제 확인이 보류되고 아무것도 지급되지 않는다 (fail closed).
MILESTONE_API_BASE=https://trainer-milestone.com

# --- 테스트 전용 ---
# 설정하면 모든 상품의 결제 금액을 이 값으로 덮어쓴다 (정가 표시는 유지).
# ⚠️ 운영 배포 시 반드시 비워둘 것.
# NEXT_PUBLIC_PAYMENT_TEST_AMOUNT=100

# --- 로컬 전용 ---
# 1이면 Supabase 없이 목 데이터로 앱 전체를 렌더링한다.
# ⚠️ 운영 배포 시 반드시 비워둘 것. 설정되면 관리자 인증이 무력화된다.
# MOCK_DASHBOARD=1
